{
  "name": "@obinexusltd/fsharp-polycall",
  "version": "1.0.0",
  "description": "F#/.NET P/Invoke binding for the Polycall binding ABI v1 (polycall >= 1.1.0). Source distribution of a .NET 8 project; not a JavaScript library.",
  "main": "index.js",
  "type": "commonjs",
  "files": [
    "index.js",
    "src/FSharpPolycall/*.fs",
    "src/FSharpPolycall/*.fsproj",
    "src/FSharpPolycall.Cli/*.fs",
    "src/FSharpPolycall.Cli/*.fsproj",
    "tests/FSharpPolycall.Tests/*.fs",
    "tests/FSharpPolycall.Tests/*.fsproj",
    "tests/fixtures/",
    "examples/*.fs",
    "examples/*.fsproj",
    "examples/fsharp-polycallrc",
    "scripts/",
    "fsharp-polycallrc",
    "polycall-binding.json",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "build": "dotnet build src/FSharpPolycall/FSharpPolycall.fsproj --configuration Release",
    "test": "sh scripts/test.sh",
    "test:package": "node tests/package.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/fsharp-polycall.git"
  },
  "keywords": [
    "libpolycall",
    "polycall",
    "fsharp",
    "dotnet",
    "pinvoke",
    "ffi"
  ],
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/obinexus/fsharp-polycall/issues"
  },
  "homepage": "https://github.com/obinexus/fsharp-polycall#readme"
}
